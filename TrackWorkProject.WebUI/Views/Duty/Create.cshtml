@using TrackWorkProject.WebUI.Entities
@model Duty
@{
    ViewData["Title"] = "Create";
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" name="Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Directorate</label>
        <select class="form-select" asp-items="ViewBag.Directorates" asp-for="DirectorateId">
            <option>Select Directorate</option>
        </select>
    </div>
   
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>


